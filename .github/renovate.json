{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["every weekday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
      "matchStrings": ["ACTIONLINT_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rhysd/actionlint",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
      "matchStrings": ["PYFLAKES_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pyflakes"
    }
  ],
  "minimumReleaseAge": "4 days",
  "gomod": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Hold scorecard-action at 2.5.x while the v2.6.0 ghcr.io image 404s (chicks-net/chicks-projects#158, ossf/scorecard-action#1752); drop this rule when upstream re-pushes the image or cuts v2.6.1",
      "matchDepNames": ["ossf/scorecard-action"],
      "allowedVersions": "2.5.x"
    },
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "patches",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates",
      "automerge": true
    },
    {
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules",
      "schedule": ["every month"],
      "automerge": true
    }
  ]
}
